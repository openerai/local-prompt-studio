{
  "name": "local-prompt-studio",
  "version": "1.0.1",
  "description": "Local desktop image-to-prompt studio for vision LLMs.",
  "main": "main.js",
  "author": "hhae0257-eng",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "launch": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win dir",
    "package:zip": "powershell -ExecutionPolicy Bypass -NoProfile -Command \"Compress-Archive -Path 'dist/win-unpacked/*' -DestinationPath 'dist/Local-Prompt-Studio-win-unpacked.zip' -Force\"",
    "test:syntax": "node -c main.js && node -c preload.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.localpromptstudio.app",
    "productName": "Local Prompt Studio",
    "artifactName": "Local-Prompt-Studio-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "INSTALL_LM_STUDIO.cmd",
      "START_LOCAL_PROMPT_STUDIO.cmd",
      "README.md",
      "assets/**/*",
      "docs/**/*",
      "models/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "zip"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "openerai",
        "repo": "local-prompt-studio",
        "releaseType": "release"
      }
    ]
  }
}
